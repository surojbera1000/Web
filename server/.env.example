# =============================================================================
# Telegram API credentials (REQUIRED, server-side only)
# -----------------------------------------------------------------------------
# Get these ONCE from https://my.telegram.org -> "API development tools".
# They live ONLY on the server and are never sent to the browser, so users
# log in with just their phone number (like the real Telegram Web).
# =============================================================================

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Port the server listens on (also serves the built frontend from ../dist).
PORT=8000

# Comma-separated allowed origins for CORS in dev (optional).
# Leave empty to allow same-origin only.
CORS_ORIGINS=http://localhost:5173
