# =============================================================================
# Firebase configuration (OPTIONAL)
# -----------------------------------------------------------------------------
# The app runs out-of-the-box using an in-browser MOCK realtime backend, so you
# do NOT need Firebase to try it.
#
# To use a real Firebase backend (Phone Auth + Realtime Database), create a
# Firebase project, enable "Phone" sign-in + Realtime Database, copy this file
# to `.env`, and fill in the values below. The app auto-detects these vars and
# switches from the mock backend to Firebase.
# =============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Force the backend regardless of the vars above. Values: "mock" | "firebase"
# Leave empty for auto-detection.
VITE_BACKEND=
