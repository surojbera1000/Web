# =============================================================================
# Telegram API credentials (REQUIRED)
# -----------------------------------------------------------------------------
# This app talks to Telegram's REAL servers via MTProto (GramJS). You MUST
# obtain your own API credentials:
#
#   1. Go to https://my.telegram.org and log in with your phone number.
#   2. Open "API development tools".
#   3. Create an application (any title/short-name). You'll get:
#        - api_id   (a number)
#        - api_hash (a 32-char hex string)
#   4. Copy this file to `.env` and paste the values below.
#
# These are PUBLIC client credentials embedded in the bundle (like any web
# client). Keep your account's 2FA password and phone safe; never commit `.env`.
# =============================================================================

VITE_TELEGRAM_API_ID=
VITE_TELEGRAM_API_HASH=
